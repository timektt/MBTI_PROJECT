{
  "name": "mbti-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rimraf .next",
    "dev": "next dev",
    "build": "npm run clean && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "env:check": "node scripts/check-env.mjs --target=development --file=.env.local",
    "env:check:preview": "node scripts/check-env.mjs --target=preview",
    "repo:hygiene": "node scripts/audit-repo-hygiene.mjs",
    "repo:hygiene:strict": "node scripts/audit-repo-hygiene.mjs --strict",
    "auth:surface": "node scripts/audit-auth-surface-isolation.mjs",
    "cloud:readiness": "node scripts/cloud-runtime-readiness.mjs",
    "cloud:readiness:strict": "node scripts/cloud-runtime-readiness.mjs --strict",
    "cloud:contracts": "npx --yes tsx scripts/verify-cloud-api-contract.ts",
    "cloud:server-contracts": "npx --yes tsx scripts/verify-cloud-server-contract.ts",
    "cloud:adapter": "npx --yes tsx scripts/verify-cloud-adapter-lifecycle.ts",
    "supabase:target": "node scripts/supabase-target-readiness.mjs",
    "vercel:target": "node scripts/vercel-target-readiness.mjs",
    "reconnect:verify": "npx --yes tsx scripts/verify-reconnect-import.ts",
    "runtime:guards": "npx --yes tsx scripts/verify-runtime-guards.ts --mode=guest-local",
    "runtime:guards:cloud": "npx --yes tsx scripts/verify-runtime-guards.ts --mode=cloud",
    "runtime:guards:all": "npm run runtime:guards && npm run runtime:guards:cloud",
    "db:bootstrap:verify": "node scripts/verify-db-bootstrap-contract.mjs",
    "data:validate": "node scripts/validate-mbti-data.mjs",
    "types:validate": "node scripts/validate-mbti-type-details.mjs",
    "assets:optimize": "node scripts/optimize-mbti-z-animal-assets.mjs",
    "assets:v2:build": "node scripts/build-fantasy-art-v2-assets.mjs",
    "assets:verify": "node scripts/verify-mbti-z-assets.mjs",
    "result-share:security": "npx --yes tsx scripts/verify-result-share-image-security.ts",
    "reconnect:cloud-import": "npx --yes tsx scripts/verify-reconnect-cloud-import.ts",
    "ui:route-sweep:verify": "node scripts/verify-ui-route-sweep.mjs",
    "ui:manifest:verify": "node scripts/verify-ui-route-state-manifest.mjs",
    "ui:held-routes:verify": "node scripts/verify-held-route-contract.mjs",
    "ui:v3:contract": "node scripts/verify-ui-v3-contract.mjs",
    "ui:v3:browser": "node scripts/run-ui-v3-browser-audit.cjs",
    "ui:v3:quality": "node scripts/verify-ui-v3-quality.mjs",
    "ui:fixtures:check": "npx --yes tsx scripts/ui-fixtures/generate.ts --check",
    "ui:fixtures:generate": "npx --yes tsx scripts/ui-fixtures/generate.ts",
    "ui:v2:quality": "node scripts/verify-ui-v2-quality.mjs",
    "ui:completion": "node scripts/verify-ui-completion.mjs",
    "preflight": "node scripts/launch-preflight.mjs --target=development --file=.env.local",
    "preflight:preview": "node scripts/launch-preflight.mjs --target=preview",
    "launch:handoff": "node scripts/generate-launch-handoff.mjs",
    "verify": "npm run repo:hygiene:strict && npm run data:validate && npm run types:validate && npm run assets:verify && npm run result-share:security && npm run db:bootstrap:verify && npm run reconnect:verify && npm run reconnect:cloud-import && npm run runtime:guards:all && npm run auth:surface && npm run ui:v3:contract && npm run ui:route-sweep:verify && npm run ui:v3:quality && npm run ui:completion && npm run cloud:contracts && npm run cloud:server-contracts && npm run cloud:adapter && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.9.0",
    "@headlessui/react": "^2.2.4",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@pusher/push-notifications-server": "^1.2.7",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vercel/og": "^0.11.1",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.6.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.5",
    "formidable": "^3.5.4",
    "framer-motion": "^12.9.2",
    "html2canvas": "^1.4.1",
    "isomorphic-dompurify": "^2.24.0",
    "lucide-react": "^0.517.0",
    "next": "15.3.1",
    "next-auth": "^4.24.11",
    "nodemailer": "^6.10.1",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-qrcode-logo": "^3.0.0",
    "react-share": "^5.2.2",
    "shadcn": "^4.10.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.49",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@prisma/client": "^6.7.0",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@types/formidable": "^3.4.5",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "postcss": "^8.5.4",
    "prisma": "^6.9.0",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.3.3",
    "typescript": "^5"
  }
}
