# App URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Runtime
NEXT_PUBLIC_MBTI_ASSESSMENT_RUNTIME=guest-local

# Auth
NEXTAUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GITHUB_ID=replace-with-github-oauth-client-id
GITHUB_SECRET=replace-with-github-oauth-client-secret

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mbti_project
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/mbti_project

# Email
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_SECURE=false
EMAIL_SERVER_USER=replace-with-email-username
EMAIL_SERVER_PASSWORD=replace-with-email-password
EMAIL_FROM=no-reply@example.com

# Realtime
PUSHER_APP_ID=replace-with-pusher-app-id
PUSHER_KEY=replace-with-pusher-key
PUSHER_SECRET=replace-with-pusher-secret
PUSHER_CLUSTER=ap1
NEXT_PUBLIC_PUSHER_KEY=replace-with-public-pusher-key
NEXT_PUBLIC_PUSHER_CLUSTER=ap1

# Media
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
